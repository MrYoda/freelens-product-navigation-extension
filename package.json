{
  "name": "@mryoda/freelens-product-navigation-extension",
  "version": "0.3.2",
  "description": "Product-oriented navigation for Freelens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrYoda/freelens-product-navigation-extension.git",
    "directory": "."
  },
  "type": "module",
  "main": "dist/main/index.cjs",
  "renderer": "dist/renderer/index.cjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "mock:kubernetes": "node scripts/gui/mock-kubernetes.mjs",
    "smoke:gui": "node scripts/gui/smoke-test.mjs",
    "smoke:settings": "node scripts/gui/settings-smoke-test.mjs",
    "pack:extension": "pnpm build && pnpm check:package && pnpm pack"
  },
  "engines": {
    "freelens": "^1.10.0"
  },
  "devDependencies": {
    "@freelensapp/extensions": "^1.10.0",
    "@types/react": "^17.0.93",
    "electron-vite": "^3.1.0",
    "mobx": "6.13.7",
    "react": "17.0.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "author": {
    "name": "Anton Kuzmichev",
    "email": "assargin@gmail.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "keywords": ["extension", "freelensapp", "freelens", "kubernetes", "navigation"],
  "lens": {
    "metadata": {
      "displayName": "Product Navigation",
      "description": "Navigate from products and components to Kubernetes namespaces and Pods"
    }
  }
}
