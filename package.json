{
  "name": "freelens-product-navigation-extension",
  "version": "0.1.6",
  "description": "Product-oriented navigation for Freelens",
  "type": "module",
  "main": "dist/main/index.cjs",
  "renderer": "dist/renderer/index.cjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "pack:extension": "pnpm build && pnpm check:package && pnpm pack"
  },
  "engines": {
    "freelens": "^1.10.0"
  },
  "devDependencies": {
    "@freelensapp/extensions": "^1.10.0",
    "@types/react": "^18.3.0",
    "electron-vite": "^3.1.0",
    "react": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "license": "MIT",
  "lens": {
    "metadata": {
      "displayName": "Product Navigation",
      "description": "Navigate from products and components to Kubernetes namespaces and Pods"
    }
  }
}
